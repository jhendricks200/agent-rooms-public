# Postgres connection string (Neon-compatible). Neon: use the pooled
# connection string from the Neon dashboard.
DATABASE_URL=postgres://user:password@localhost:5432/agent_rooms

# GitHub App credentials for SHA-pinned PR-merge adoption (src/lib/github.ts).
# When absent, the adopt route stubs the merge call instead of calling GitHub.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# OpenRouter key for the sidebar agent (src/lib/model.ts). Requests pin to
# US/EU-hosted providers only, see the constant in that file.
OPENROUTER_API_KEY=

# Per-session token cap for the sidebar agent's shadow ledger, windowed to
# the current UTC day. This is one of three caps enforced by
# src/lib/budget.ts, and all three are windowed on the same boundary and
# reset together at midnight UTC (00:00 UTC), none of them being a lifetime
# total:
#   - this AGENT_DAILY_TOKEN_CAP, per agent session
#   - rooms.token_budget_per_room, per room
#   - rooms.token_budget_per_user, per contributor per room
# Windowed usage is summed from agent_usage_reservations rows created at or
# after the boundary, counting only 'pending' and 'committed' rows, so a
# released reservation (failed, aborted, or swept-stale request) counts
# against nothing. rooms.token_budget_used remains a monotonic lifetime
# counter for display only and is not an input to any cap check.
# A non-numeric or negative value here fails closed to the default (200000)
# rather than disabling the cap.
AGENT_DAILY_TOKEN_CAP=200000

# Override the model API base URL for local verification when the
# OpenRouter account has no credits yet. Leave unset in production.
MODEL_BASE_URL=

# GitHub OAuth App sign-in (Auth.js/NextAuth). Client id defaults to the
# registered app (Iv23liGWHQRprQK8V1kZ) if unset. Sign-in activates
# automatically once GITHUB_OAUTH_CLIENT_SECRET is present; without it the
# sign-in button will not complete and shows a config message instead of
# crashing the app.
GITHUB_OAUTH_CLIENT_ID=Iv23liGWHQRprQK8V1kZ
GITHUB_OAUTH_CLIENT_SECRET=

# NextAuth session signing secret. A dev-only random value is generated into
# .env automatically if this is absent; set a real one in production.
AUTH_SECRET=

# NEVER set this in production. When NODE_ENV=development AND this is '1',
# an unauthenticated request resolves to the seeded contributor_priya
# identity so local demo/verify scripts keep working without real sign-in.
DEV_IDENTITY_FALLBACK=
